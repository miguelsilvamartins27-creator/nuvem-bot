# Credenciais Groq (IA)
GROQ_API_KEY=sua_chave_groq_aqui

# Modelo de visão para análise de fotos (opcional, padrão: qwen/qwen3.8-27b)
GROQ_VISAO_MODELO=

# Credenciais Gemini (Google AI Studio, opcional - fallback)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Credenciais OpenRouter (opcional - fallback)
# Aceita somente modelos grátis (:free ou openrouter/free) por padrão.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_REFERER=
OPENROUTER_TITULO=

# Modelos por provedor (opcionais)
GEMINI_MODELO_TEXTO=gemini-2.5-flash
GEMINI_MODELO_VISAO=
OPENROUTER_MODELO_TEXTO=openrouter/free
OPENROUTER_MODELO_VISAO=

# Ordem de tentativa dos provedores (opcional, padrão: groq,gemini,openrouter)
IA_TEXTO_ORDEM=
IA_VISAO_ORDEM=

# Autoriza modelos pagos no OpenRouter (padrão: false)
IA_PERMITIR_PAGO=false

# Pula provedor que já passou do limite diário conhecido (padrão: false)
# Os limites são referência de 16/10/2026 e podem mudar; erros reais das
# APIs sempre têm prioridade.
IA_LIMITES_DUROS=false

# Tentativas por provedor antes de cair para o próximo (padrão: 2)
IA_TENTATIVAS=2

# Timeout por requisição em ms (padrão: 45000)
IA_TIMEOUT_MS=45000

# Persiste contador diário de uso em bot_data/ia_uso.json (padrão: false)
# Apenas auxiliar: no Render o disco é efêmero e os contadores reiniciam
# a cada deploy/restart.
IA_PERSISTIR_USO=false

# Credenciais Supabase (Banco de Dados)
SUPABASE_URL=https://seu_projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui

# Identificação do Chat Pessoal (formato: numero@lid ou numero@s.whatsapp.net)
MY_WHATSAPP_CHAT_ID=5511999999999@s.whatsapp.net

# Porta do Servidor HTTP (opcional, padrão: 3000)
PORT=3000

# Ambiente de Execução (development ou production)
NODE_ENV=production
