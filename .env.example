# Credenciais Groq (IA)
GROQ_API_KEY=sua_chave_groq_aqui

# Modelo de visão para análise de fotos (opcional, padrão: qwen/qwen3.8-27b)
GROQ_VISAO_MODELO=

# Credenciais Supabase (Banco de Dados)
SUPABASE_URL=https://seu_projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui

# Identificação do Chat Pessoal (formato: numero@lid ou numero@s.whatsapp.net)
MY_WHATSAPP_CHAT_ID=5511999999999@s.whatsapp.net

# Porta do Servidor HTTP (opcional, padrão: 3000)
PORT=3000

# Ambiente de Execução (development ou production)
NODE_ENV=production
